generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  ADMIN
  OWNER
  TENANT
  LANDLORD
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum FinancialType {
  INCOME
  EXPENSE
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique // Used for subdomain (e.g. slx.imob.com)
  logoUrl       String?
  primaryColor  String   @default("#6D28D9")
  secondaryColor String   @default("#06B6D4")
  config        String?  @default("{}") // Store JSON as string for SQLite compatibility if needed, or Json for other DBs
  
  users         User[]
  documents     Document[]
  financials    FinancialRecord[]
  inspections   Inspection[]
  properties    Property[]
  logs          Log[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([slug])
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String
  phone             String?
  role              String   @default("TENANT") // Comma separated roles: "ADMIN", "TENANT", "LANDLORD", etc.
  permissions       String?  @default("{}") // JSON string of granular permissions
  cpf               String?  @unique
  isEmailVerified   Boolean  @default(false)
  
  asaasId           String?  @unique
  
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  
  documents         Document[]
  financials        FinancialRecord[]
  inspections       Inspection[]
  properties        Property[]       @relation("LandlordProperties")
  logs              Log[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([tenantId])
  @@index([asaasId])
  @@index([email])
}

model Document {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   // e.g. "CONTRACT", "RECEIPT", "ID"
  
  // Metadata for contracts
  amount    Float?
  address   String?
  duration  String?
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  visibility String?  @default("ALL") // "TENANT", "LANDLORD", "ALL"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([userId])
}

model FinancialRecord {
  id            String          @id @default(cuid())
  description   String
  amount        Float
  dueDate       DateTime
  paymentDate   DateTime?
  type          FinancialType
  status        FinancialStatus @default(PENDING)
  
  asaasId       String?         @unique // ID from Asaas integration
  asaasUrl      String?         // URL for the boleto/payment
  
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([userId])
  @@index([asaasId])
}

model Inspection {
  id              String   @id @default(cuid())
  propertyAddress String
  propertyNumber  String?
  cep             String?
  propertyType    String?  // RESIDENTIAL, COMMERCIAL
  date            DateTime @default(now())
  
  // People
  landlordData    String?  @default("{}") // JSON: { name, cpf, rg, profession }
  tenantData      String?  @default("{}") // JSON: { name, cpf, rg, profession }
  inspectorData   String?  @default("{}") // JSON: { name, creci, cpf }
  
  // Status
  status          String   @default("DRAFT") // DRAFT, FINALIZED
  
  // Tenant Relation
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  // User who created
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  // Rooms
  rooms           InspectionRoom[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([tenantId])
  @@index([userId])
}

model InspectionRoom {
  id           String   @id @default(cuid())
  name         String   // e.g. "Sala", "Cozinha"
  order        Int      @default(0)
  
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  items        InspectionItem[]
  photos       InspectionPhoto[]
  videos       InspectionVideo[]

  @@index([inspectionId])
}

model InspectionItem {
  id            String   @id @default(cuid())
  description   String   // e.g. "Paredes: Pintura nova, sem rachaduras"
  observations  String?  
  status        String?  // BOM, REGULAR, RUIM
  videoUrl      String?
  
  roomId        String
  room          InspectionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  photos        InspectionPhoto[]
  videos        InspectionVideo[]

  @@index([roomId])
}

model InspectionPhoto {
  id            String   @id @default(cuid())
  url           String
  
  roomId        String?
  room          InspectionRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  itemId        String?
  item          InspectionItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([itemId])
}

model InspectionVideo {
  id            String   @id @default(cuid())
  url           String
  
  roomId        String?
  room          InspectionRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  itemId        String?
  item          InspectionItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([itemId])
}

model Property {
  id              String   @id @default(cuid())
  address         String
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  zipCode         String?
  type            String?  // RESIDENTIAL, COMMERCIAL, etc.
  
  landlordId      String
  landlord        User     @relation("LandlordProperties", fields: [landlordId], references: [id])
  
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([landlordId])
  @@index([tenantId])
}

model Log {
  id        String   @id @default(cuid())
  action    String
  details   String?
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}
