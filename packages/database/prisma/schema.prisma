generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  TENANT
  LANDLORD
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum FinancialType {
  INCOME
  EXPENSE
}

model Tenant {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  slug          String   @unique
  logoUrl       String?
  primaryColor  String   @default("#6D28D9")
  secondaryColor String   @default("#06B6D4")
  config        String?  @default("{}")

  users         User[]
  documents     Document[]
  financials    FinancialRecord[]
  inspections   Inspection[]
  properties    Property[]
  logs          Log[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model User {
  id                String   @id @default(cuid()) @map("_id")
  email             String   @unique
  password          String
  name              String
  phone             String?
  role              String   @default("TENANT")
  permissions       String?  @default("{}")
  cpf               String?  @unique
  isEmailVerified   Boolean  @default(false)
  photoUrl          String?
  creci             String?

  asaasId           String?  @unique

  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  documents         Document[]
  financials        FinancialRecord[]
  inspections       Inspection[]
  properties        Property[]       @relation("LandlordProperties")
  logs              Log[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([tenantId])
}

model Document {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  url       String
  type      String

  amount    Float?
  address   String?
  duration  String?

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  visibility String?  @default("ALL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([userId])
}

model FinancialRecord {
  id            String          @id @default(cuid()) @map("_id")
  description   String
  amount        Float
  dueDate       DateTime
  paymentDate   DateTime?
  type          FinancialType
  status        FinancialStatus @default(PENDING)

  asaasId       String?         @unique
  asaasUrl      String?

  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])

  userId        String
  user          User            @relation(fields: [userId], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([userId])
}

model Inspection {
  id              String   @id @default(cuid()) @map("_id")
  propertyAddress String
  propertyNumber  String?
  cep             String?
  propertyType    String?
  date            DateTime @default(now())

  landlordData    String?  @default("{}")
  tenantData      String?  @default("{}")
  inspectorData   String?  @default("{}")

  status          String   @default("DRAFT")

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  rooms           InspectionRoom[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([tenantId])
  @@index([userId])
}

model InspectionRoom {
  id           String   @id @default(cuid()) @map("_id")
  name         String
  order        Int      @default(0)

  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id])

  items        InspectionItem[]
  photos       InspectionPhoto[]
  videos       InspectionVideo[]

  @@index([inspectionId])
}

model InspectionItem {
  id            String   @id @default(cuid()) @map("_id")
  description   String
  observations  String?
  status        String?
  videoUrl      String?

  roomId        String
  room          InspectionRoom @relation(fields: [roomId], references: [id])

  photos        InspectionPhoto[]
  videos        InspectionVideo[]

  @@index([roomId])
}

model InspectionPhoto {
  id            String   @id @default(cuid()) @map("_id")
  url           String

  roomId        String?
  room          InspectionRoom? @relation(fields: [roomId], references: [id])

  itemId        String?
  item          InspectionItem? @relation(fields: [itemId], references: [id])

  @@index([roomId])
  @@index([itemId])
}

model InspectionVideo {
  id            String   @id @default(cuid()) @map("_id")
  url           String

  roomId        String?
  room          InspectionRoom? @relation(fields: [roomId], references: [id])

  itemId        String?
  item          InspectionItem? @relation(fields: [itemId], references: [id])

  @@index([roomId])
  @@index([itemId])
}

model Property {
  id              String   @id @default(cuid()) @map("_id")
  address         String
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  zipCode         String?
  type            String?

  landlordId      String
  landlord        User     @relation("LandlordProperties", fields: [landlordId], references: [id])

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([landlordId])
  @@index([tenantId])
}

model Log {
  id        String   @id @default(cuid()) @map("_id")
  action    String
  details   String?

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Media {
  id        String   @id @default(cuid()) @map("_id")
  filename  String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}
